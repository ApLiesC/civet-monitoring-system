
{
    "models": {
        "detector": "models/civet_detector_yolo11n-2/weights/best.pt",
        "classifier": "models/civet_classifier_yolo11n/weights/best.pt"
    },

    "video": {
        "input": "data/videos/locomotion11.mp4",
        "sample_fps": 8
